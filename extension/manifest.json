{
  "manifest_version": 3,
  "name": "Video Recap",
  "version": "0.1",
  "description": "Recap the part of a YouTube video you've already watched.",

  "permissions": ["activeTab"],

  "host_permissions": ["http://localhost:3000/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ]
}
